# Public Twitch app: no client secret and no redirect URI.
HOST=127.0.0.1
PORT=3000
TWITCH_CLIENT_ID=
TWITCH_TEAM_A_LOGIN=
TWITCH_TEAM_B_LOGIN=
# Blank follows Team A; a third bot account is also supported.
TWITCH_BOT_LOGIN=
# Tokens are stored with owner-only file permissions. Never put this in public/.
TWITCH_TOKEN_FILE=.local/twitch-tokens.json
